{
  "manifest_version": 3,
  "name": "Job Search Assistant",
  "version": "0.1.0",
  "description": "Capture job pages from authenticated tabs and fill forms later.",
  "action": {
    "default_title": "Job Search Assistant",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
