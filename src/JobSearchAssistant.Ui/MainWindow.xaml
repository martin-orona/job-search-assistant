<Window x:Class="JobSearchAssistant.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Job Search Assistant" Height="720" Width="1080" MinWidth="720" MinHeight="480">
    <Grid Margin="12">
        <TabControl>
            <TabItem Header="Applications">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="ListeningToggleButton"
                            Content="Start Listening"
                            Width="120"
                            Height="26"
                            Margin="8,0,0,0"
                            Checked="ListeningToggleButton_Checked"
                            Unchecked="ListeningToggleButton_Unchecked" />

                        <Button Content="Clear Display"
                            Width="80"
                            Height="26"
                            Margin="8,0,0,0"
                            Click="ClearDisplayButton_Click" />

                        <CheckBox Content="Word Wrap"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="True"
                                  Click="WordWrapCheckBox_Click" />

                        <TextBlock Text="Date Context"
                                  Margin="16,0,6,0"
                                  VerticalAlignment="Center" />

                        <TextBox x:Name="ManualDateTextBox"
                                 Width="140"
                                 Height="26"
                                 VerticalAlignment="Center"
                                 ToolTip="Enter yyyymmdd or yyyymmdd DayName" />

                        <Button Content="Set Date"
                                Width="60"
                                Height="26"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Click="SetDateContextButton_Click" />

                        <Button Content="Read Clipboard"
                            Width="100"
                            Height="26"
                            Margin="16,0,0,0"
                            Click="ShowClipboardButton_Click" />

                        <Button Content="Write to Excel"
                            Width="100"
                            Height="26"
                            Margin="8,0,0,0"
                            Click="WriteToExcelButton_Click" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="OneNote Link"
                                   FontWeight="SemiBold" />

                        <TextBlock x:Name="OneNoteStatusTextBlock"
                                   Grid.Column="1"
                                   Text="Status: Ready"
                                   Foreground="DimGray"
                                   FontSize="12"
                                   VerticalAlignment="Bottom" />
                    </Grid>

                    <TextBox x:Name="ClipboardLinkTextBox"
                             Grid.Row="3"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             Height="110"
                             Margin="0,0,0,2" />

                    <TextBlock Grid.Row="5"
                               Text="Clipboard Contents"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />

                    <TextBox x:Name="ClipboardDumpTextBox"
                             Grid.Row="6"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="13" />
                </Grid>
            </TabItem>

            <TabItem Header="Resume Analyzer" Selector.IsSelected="True">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- <ToolBarTray>
                        <ToolBar>
                            <Button Content="Merge"
                                    Width="90"
                                    Height="26"
                                    Click="MergeButton_Click" />
                        </ToolBar>
                    </ToolBarTray> -->

                    <TextBlock x:Name="ResumeAnalyzerStatusTextBlock"
                               Grid.Row="2"
                               Text="Status: Ready"
                               Foreground="DimGray"
                               FontSize="12" />

                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,4,0,0">

                            <Expander x:Name="GeneratedPromptSectionExpander" Header="AI Prompt" IsExpanded="True">
                                <StackPanel Margin="8">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Prompt AI"
                                                Width="70"
                                                Height="26"
                                                Click="PromptAiButton_Click" />
                                        <Button Content="Generate Prompt"
                                                Width="110"
                                                Height="26"
                                                Margin="8,0,0,0"
                                                Click="GeneratePromptButton_Click" />
                                        <Button Content="Copy Prompt"
                                                Width="90"
                                                Height="26"
                                                Margin="8,0,0,0"
                                                Click="CopyPromptButton_Click" />
                                        <Button Content="Open AI"
                                            Width="70"
                                            Height="26"
                                            Margin="8,0,0,0"
                                            Click="OpenAiButton_Click" />
                                        <TextBox x:Name="AiUrlTextBox"
                                             Width="380"
                                             Height="26"
                                             Margin="8,0,0,0"
                                             VerticalContentAlignment="Center"
                                             ToolTip="URL to open for your AI assistant" />
                                    </StackPanel>

                                    <Expander x:Name="GeneratedPromptContentExpander" Header="Prompt" IsExpanded="True">
                                        <TextBox x:Name="GeneratedPromptTextBox"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="True"
                                                 MinHeight="200"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas"
                                                 FontSize="13" />
                                    </Expander>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="JobDescriptionSectionExpander" Header="Job Description" IsExpanded="True" Margin="0,0,0,8">
                                <StackPanel Margin="8">
                                    <DockPanel Margin="0,0,0,8">
                                        <Button Content="From Clipboard"
                                                Width="100"
                                                Height="26"
                                                Margin="0,0,0,0"
                                                Click="CopyJobDescriptionFromClipboardButton_Click" />
                                        <Button Content="Select File"
                                                Width="70"
                                                Height="26"
                                                DockPanel.Dock="Right"
                                                Margin="8,0,0,0"
                                                Click="SelectJobDescriptionFileButton_Click" />
                                        <TextBox x:Name="JobDescriptionPathTextBox"
                                                 IsReadOnly="True"
                                                 VerticalContentAlignment="Center"
                                                 Margin="12,0,0,0"
                                                 ToolTip="Path to the job description file" />
                                    </DockPanel>

                                    <Expander x:Name="JobDescriptionContentExpander" Header="Description" IsExpanded="True">
                                        <TextBox x:Name="JobDescriptionContentTextBox"
                                                 IsReadOnly="False"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="True"
                                                 MinHeight="160"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas"
                                                 FontSize="13" />
                                    </Expander>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="ResumeSectionExpander" Header="Resume" IsExpanded="True" Margin="0,0,0,8">
                                <StackPanel Margin="8">
                                    <DockPanel Margin="0,0,0,8">
                                        <Button Content="From Clipboard"
                                                Width="100"
                                                Height="26"
                                                Margin="0,0,0,0"
                                                Click="CopyResumeFromClipboardButton_Click" />
                                        <Button Content="Select File"
                                                Width="70"
                                                Height="26"
                                                DockPanel.Dock="Right"
                                                Margin="8,0,0,0"
                                                Click="SelectResumeFileButton_Click" />
                                        <TextBox x:Name="ResumePathTextBox"
                                                 IsReadOnly="True"
                                                 VerticalContentAlignment="Center"
                                                 Margin="12,0,0,0"
                                                 ToolTip="Path to the resume file" />
                                    </DockPanel>

                                    <Expander x:Name="ResumeContentExpander" Header="Resume" IsExpanded="True">
                                        <TextBox x:Name="ResumeContentTextBox"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="True"
                                                 MinHeight="160"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas"
                                                 FontSize="13" />
                                    </Expander>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="PromptTemplateSectionExpander" Header="AI Prompt Template" IsExpanded="True" Margin="0,0,0,8">
                                <StackPanel Margin="8">
                                    <DockPanel Margin="0,0,0,8">
                                        <Button Content="Select File"
                                                Width="90"
                                                Height="26"
                                                DockPanel.Dock="Right"
                                                Margin="8,0,0,0"
                                                Click="SelectPromptTemplateFileButton_Click" />
                                        <TextBox x:Name="PromptTemplatePathTextBox"
                                                 IsReadOnly="True"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Path to the AI prompt template file" />
                                    </DockPanel>

                                    <Expander x:Name="PromptTemplateContentExpander" Header="Template" IsExpanded="True">
                                        <TextBox x:Name="PromptTemplateContentTextBox"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="True"
                                                 MinHeight="160"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas"
                                                 FontSize="13" />
                                    </Expander>
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
