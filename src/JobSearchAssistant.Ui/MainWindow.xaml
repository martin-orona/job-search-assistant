<Window x:Class="JobSearchAssistant.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Clipboard Inspector" Height="720" Width="1080" MinWidth="720" MinHeight="480">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="Read Clipboard"
                Width="160"
                Height="36"
                Click="ShowClipboardButton_Click" />

            <Button Content="Write to Excel"
                Width="140"
                Height="36"
                Margin="8,0,0,0"
                Click="WriteToExcelButton_Click" />

            <ToggleButton x:Name="ListeningToggleButton"
                Content="Start Listening"
                Width="150"
                Height="36"
                Margin="8,0,0,0"
                Checked="ListeningToggleButton_Checked"
                Unchecked="ListeningToggleButton_Unchecked" />

            <Button Content="Clear Display"
                Width="140"
                Height="36"
                Margin="8,0,0,0"
                Click="ClearDisplayButton_Click" />

            <CheckBox Content="Word Wrap"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      IsChecked="True"
                      Click="WordWrapCheckBox_Click" />

                <TextBlock Text="Date Context"
                      Margin="16,0,6,0"
                      VerticalAlignment="Center" />

                <TextBox x:Name="ManualDateTextBox"
                     Width="140"
                     Height="28"
                     VerticalAlignment="Center"
                     ToolTip="Enter yyyymmdd or yyyymmdd DayName" />

                <Button Content="Set Date"
                    Width="90"
                    Height="30"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="SetDateContextButton_Click" />
        </StackPanel>

            <Grid Grid.Row="2" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="OneNote Link"
                           FontWeight="SemiBold" />

                <TextBlock x:Name="OneNoteStatusTextBlock"
                           Grid.Column="1"
                           Text="Status: Ready"
                           Foreground="DimGray"
                           FontSize="12"
                           VerticalAlignment="Bottom" />
            </Grid>

            <TextBox x:Name="ClipboardLinkTextBox"
                 Grid.Row="3"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"
                 FontFamily="Consolas"
                 FontSize="13"
                 Height="110"
                 Margin="0,0,0,2" />

                <TextBlock Grid.Row="5"
                                     Text="Clipboard Contents"
                                     FontWeight="SemiBold"
                                     Margin="0,0,0,4" />

        <TextBox x:Name="ClipboardDumpTextBox"
                                 Grid.Row="6"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 TextWrapping="Wrap"
                 FontFamily="Consolas"
                 FontSize="13" />
    </Grid>
</Window>
