<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="JobSearchAssistant.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:JobSearchAssistant.Maui"
    Title="Maui"
    BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                      Dark={StaticResource Gray900}}"
    ForegroundColor="White"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                                  Dark={StaticResource Gray900}}"
    Shell.TabBarForegroundColor="White"
    Shell.TabBarUnselectedColor="White">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
