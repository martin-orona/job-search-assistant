<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="JobSearchAssistant.Maui.ResumeAnalyzerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:JobSearchAssistant.Maui.Components"
    Title="Resume Analyzer">
    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" HeightRequest="1" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="15">
                <Border
                    Stroke="DodgerBlue"
                    StrokeShape="{RoundRectangle CornerRadius=6}"
                    StrokeThickness="1">

                    <Label
                        x:Name="StatusLabel"
                        Margin="0,0,0,10"
                        FontSize="14"
                        Text="Ready"
                        TextColor="#666666" />

                </Border>

                <Border
                    x:Name="AiPrompt_Container_Expander"
                    components:Expander.IsExpanded="False"
                    Style="{StaticResource ExpanderContainer}"
                    StyleClass="ExpanderContainer">
                    <VerticalStackLayout Style="{StaticResource ExpanderContent}" StyleClass="ExpanderContent">
                        <HorizontalStackLayout Style="{StaticResource ExpanderHeader}" StyleClass="ExpanderHeader">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnExpanderToggleTapped" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label
                                x:Name="AiPromptToggle"
                                Margin="0,0,10,0"
                                FontSize="14"
                                Style="{StaticResource ExpanderToggleSymbol}"
                                StyleClass="ExpanderToggleSymbol"
                                Text="▼"
                                VerticalOptions="Center" />
                            <Label
                                FontAttributes="Bold"
                                Text="AI Prompt"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout
                            x:Name="AiPromptContent"
                            Style="{StaticResource ExpanderBody}"
                            StyleClass="ExpanderBody">
                            <Grid ColumnSpacing="8" RowSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="PromptAiButton"
                                    Text="Prompt AI" 
                                    Grid.Column="0"
                                    Padding="8,0"
                                    Clicked="OnPromptAiClicked"
                                />
                                <Button
                                    x:Name="GeneratePromptButton"
                                    Text="Generate Prompt" 
                                    Grid.Column="1"
                                    Padding="8,0"
                                    Clicked="OnGeneratePromptClicked"
                                />
                                <Button
                                    x:Name="CopyPromptButton"
                                    Text="Copy Prompt" 
                                    Grid.Column="2"
                                    Padding="8,0"
                                    Clicked="OnCopyPromptClicked"
                                />
                                <Button
                                    x:Name="OpenAiButton"
                                    Text="Open AI" 
                                    Grid.Column="3"
                                    Padding="8,0"
                                    Clicked="OnOpenAiClicked"
                                />
                                <Entry
                                    x:Name="AiUrlEntry"
                                    Grid.Column="4"
                                    FontSize="12"
                                    HeightRequest="32"
                                    MinimumHeightRequest="32"
                                    Placeholder="AI URL (e.g., https://chatgpt.com)"
                                    Unfocused="OnAiUrlEntryUnfocused" />
                            </Grid>
                            <Border
                                x:Name="AiPrompt_Content_Expander"
                                components:Expander.IsExpanded="False"
                                Style="{StaticResource ExpanderContainer}"
                                StyleClass="ExpanderContainer">
                                <VerticalStackLayout Style="{StaticResource ExpanderContent}" StyleClass="ExpanderContent">
                                    <HorizontalStackLayout Style="{StaticResource ExpanderHeader}" StyleClass="ExpanderHeader">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnExpanderToggleTapped" />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Label
                                            x:Name="AiPromptContentToggle"
                                            Margin="0,0,8,0"
                                            FontSize="12"
                                            Style="{StaticResource ExpanderToggleSymbol}"
                                            StyleClass="ExpanderToggleSymbol"
                                            Text="▼"
                                            VerticalOptions="Center" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            Text="Content"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout
                                        Spacing="8"
                                        Style="{StaticResource ExpanderBody}"
                                        StyleClass="ExpanderBody">
                                        <Editor
                                            x:Name="AiPromptEditor"
                                            AutoSize="TextChanges"
                                            MinimumHeightRequest="60"
                                            Placeholder="Generated prompt will appear here..."
                                            Style="{StaticResource ExpanderBody}"
                                            StyleClass="ExpanderBody" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="JobDescription_Container_Expander"
                    components:Expander.IsExpanded="False"
                    Style="{StaticResource ExpanderContainer}"
                    StyleClass="ExpanderContainer">
                    <VerticalStackLayout Style="{StaticResource ExpanderContent}" StyleClass="ExpanderContent">
                        <HorizontalStackLayout Style="{StaticResource ExpanderHeader}" StyleClass="ExpanderHeader">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnExpanderToggleTapped" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label
                                x:Name="JobDescriptionToggle"
                                Margin="0,0,10,0"
                                FontSize="14"
                                Style="{StaticResource ExpanderToggleSymbol}"
                                StyleClass="ExpanderToggleSymbol"
                                Text="▼"
                                VerticalOptions="Center" />
                            <Label
                                FontAttributes="Bold"
                                Text="Job Description"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout Style="{StaticResource ExpanderBody}" StyleClass="ExpanderBody">
                            <Grid ColumnSpacing="8" RowSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="FromClipboardButton"
                                    Text="From Clipboard" 
                                    Grid.Column="0"
                                    Padding="8,0"
                                    Clicked="OnFromClipboardClicked"
                                />
                                <Button
                                    x:Name="FromFileButton"
                                    Text="From File" 
                                    Grid.Column="1"
                                    Padding="8,0"
                                    Clicked="OnFromFileClicked"
                                />
                                <Entry
                                    x:Name="JobDescriptionFilePath"
                                    Placeholder="File path..." 
                                    Grid.Column="2"
                                    IsReadOnly="True"
                                />
                                <Button
                                    x:Name="SelectFileButton"
                                    Text="Select File"
                                    Grid.Column="3"
                                    Padding="8,0"
                                    Clicked="OnSelectJobDescriptionFileClicked"
                                />
                                <Button
                                    x:Name="OpenFileButton"
                                    Text="Open File" 
                                    Grid.Column="4"
                                    Padding="8,0"
                                    Clicked="OnOpenJobDescriptionFileClicked"
                                />
                            </Grid>
                            <Border
                                x:Name="JobDescription_Content_Expander"
                                components:Expander.IsExpanded="False"
                                Style="{StaticResource ExpanderContainer}"
                                StyleClass="ExpanderContainer">
                                <VerticalStackLayout Style="{StaticResource ExpanderContent}" StyleClass="ExpanderContent">
                                    <HorizontalStackLayout>
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnExpanderToggleTapped" />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Label
                                            x:Name="DescriptionToggle"
                                            Margin="0,0,8,0"
                                            FontSize="12"
                                            Style="{StaticResource ExpanderToggleSymbol}"
                                            StyleClass="ExpanderToggleSymbol"
                                            Text="▼"
                                            VerticalOptions="Center" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            Text="Content"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout
                                        Spacing="8"
                                        Style="{StaticResource ExpanderBody}"
                                        StyleClass="ExpanderBody">
                                        <Editor
                                            x:Name="JobDescriptionEditor"
                                            AutoSize="TextChanges"
                                            MinimumHeightRequest="60"
                                            Placeholder="File contents will appear here..." />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="Resume_Container_Expander"
                    components:Expander.IsExpanded="False"
                    Style="{StaticResource ExpanderContainer}"
                    StyleClass="ExpanderContainer">
                    <VerticalStackLayout Style="{StaticResource ExpanderContent}" StyleClass="ExpanderContent">
                        <HorizontalStackLayout Style="{StaticResource ExpanderHeader}" StyleClass="ExpanderHeader">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnExpanderToggleTapped" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label
                                x:Name="ResumeToggle"
                                Margin="0,0,10,0"
                                FontSize="14"
                                Style="{StaticResource ExpanderToggleSymbol}"
                                StyleClass="ExpanderToggleSymbol"
                                Text="▼"
                                VerticalOptions="Center" />
                            <Label
                                FontAttributes="Bold"
                                Text="Resume"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout
                            x:Name="ResumeContent"
                            Style="{StaticResource ExpanderBody}"
                            StyleClass="ExpanderBody">
                            <Grid ColumnSpacing="8" RowSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="ResumeFromClipboardButton"
                                    Text="From Clipboard" 
                                    Grid.Column="0"
                                    Padding="8,0"
                                    Clicked="OnResumeFromClipboardClicked"
                                />
                                <Button
                                    x:Name="ResumeFromFileButton"
                                    Text="From File" 
                                    Grid.Column="1"
                                    Padding="8,0"
                                    Clicked="OnResumeFromFileClicked"
                                />
                                <Entry
                                    x:Name="ResumeFilePath"
                                    Grid.Column="2"
                                    FontSize="12"
                                    HeightRequest="32"
                                    IsReadOnly="True"
                                    MinimumHeightRequest="32"
                                    Placeholder="File path..." />
                                <Button
                                    x:Name="ResumeSelectFileButton"
                                    Text="Select File" 
                                    Grid.Column="3"
                                    Padding="8,0"
                                    Clicked="OnResumeSelectFileClicked"
                                />
                                <Button
                                    x:Name="ResumeOpenFileButton"
                                    Text="Open File" 
                                    Grid.Column="4"
                                    Padding="8,0"
                                    Clicked="OnResumeOpenFileClicked"
                                />
                            </Grid>
                            <Border
                                x:Name="Resume_Content_Expander"
                                components:Expander.IsExpanded="False"
                                Style="{StaticResource ExpanderContainer}"
                                StyleClass="ExpanderContainer">
                                <VerticalStackLayout Style="{StaticResource ExpanderContent}" StyleClass="ExpanderContent">
                                    <HorizontalStackLayout Style="{StaticResource ExpanderHeader}" StyleClass="ExpanderHeader">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnExpanderToggleTapped" />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Label
                                            x:Name="ResumeContentToggle"
                                            Margin="0,0,8,0"
                                            FontSize="12"
                                            Style="{StaticResource ExpanderToggleSymbol}"
                                            StyleClass="ExpanderToggleSymbol"
                                            Text="▼"
                                            VerticalOptions="Center" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            Text="Content"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout
                                        Spacing="8"
                                        Style="{StaticResource ExpanderBody}"
                                        StyleClass="ExpanderBody">
                                        <Editor
                                            x:Name="ResumeEditor"
                                            AutoSize="TextChanges"
                                            MinimumHeightRequest="60"
                                            Placeholder="File contents will appear here..." />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="AiPromptTemplate_Container_Expander"
                    components:Expander.IsExpanded="False"
                    Style="{StaticResource ExpanderContainer}"
                    StyleClass="ExpanderContainer">
                    <VerticalStackLayout Style="{StaticResource ExpanderContent}" StyleClass="ExpanderContent">
                        <HorizontalStackLayout Style="{StaticResource ExpanderHeader}" StyleClass="ExpanderHeader">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnExpanderToggleTapped" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label
                                x:Name="TemplateToggle"
                                Margin="0,0,10,0"
                                FontSize="14"
                                Style="{StaticResource ExpanderToggleSymbol}"
                                StyleClass="ExpanderToggleSymbol"
                                Text="▼"
                                VerticalOptions="Center" />
                            <Label
                                FontAttributes="Bold"
                                Text="AI Prompt Template"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout
                            x:Name="TemplateContent"
                            Style="{StaticResource ExpanderBody}"
                            StyleClass="ExpanderBody">
                            <Grid ColumnSpacing="8" RowSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="TemplateFromClipboardButton"
                                    Text="From Clipboard" 
                                    Grid.Column="0"
                                    Padding="8,0"
                                    Clicked="OnTemplateFromClipboardClicked"
                                />
                                <Button
                                    x:Name="TemplateFromFileButton"
                                    Text="From File" 
                                    Grid.Column="1"
                                    Padding="8,0"
                                    Clicked="OnTemplateFromFileClicked"
                                />
                                <Entry
                                    x:Name="TemplateFilePath"
                                    Grid.Column="2"
                                    FontSize="12"
                                    HeightRequest="32"
                                    IsReadOnly="True"
                                    MinimumHeightRequest="32"
                                    Placeholder="File path..." />
                                <Button
                                    x:Name="TemplateSelectFileButton"
                                    Text="Select File" 
                                    Grid.Column="3"
                                    Padding="8,0"
                                    Clicked="OnTemplateSelectFileClicked"
                                />
                                <Button
                                    x:Name="TemplateOpenFileButton"
                                    Text="Open File" 
                                    Grid.Column="4"
                                    Padding="8,0"
                                    Clicked="OnTemplateOpenFileClicked"
                                />
                            </Grid>
                            <Border
                                x:Name="AiPromptTemplate_Content_Expander"
                                components:Expander.IsExpanded="False"
                                Style="{StaticResource ExpanderContainer}"
                                StyleClass="ExpanderContainer">
                                <VerticalStackLayout Style="{StaticResource ExpanderContent}" StyleClass="ExpanderContent">
                                    <HorizontalStackLayout Style="{StaticResource ExpanderHeader}" StyleClass="ExpanderHeader">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnExpanderToggleTapped" />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Label
                                            x:Name="TemplateContentToggle"
                                            Margin="0,0,8,0"
                                            FontSize="12"
                                            Style="{StaticResource ExpanderToggleSymbol}"
                                            StyleClass="ExpanderToggleSymbol"
                                            Text="▼"
                                            VerticalOptions="Center" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            Text="Content"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout
                                        Spacing="8"
                                        Style="{StaticResource ExpanderBody}"
                                        StyleClass="ExpanderBody">
                                        <Editor
                                            x:Name="TemplateEditor"
                                            AutoSize="TextChanges"
                                            MinimumHeightRequest="60"
                                            Placeholder="File contents will appear here..." />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
