# Build outputs
**/bin/
**/obj/
**/Debug/

# Visual Studio / Rider / VS Code local settings
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.DotSettings.user

# VS Code workspace-local state
.vscode/*.code-workspace

# Logs and test results
*.log
TestResults/

# NuGet packages (machine-local cache folders)
packages/

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
