{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clean JobSearchAssistant.Ui",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "clean",
        "${workspaceFolder}/src/JobSearchAssistant.Ui/JobSearchAssistant.Ui.csproj",
        "/property:GenerateFullPaths=true",
        "/p:Configuration=Debug"
      ],
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "build JobSearchAssistant.Ui",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/JobSearchAssistant.Ui/JobSearchAssistant.Ui.csproj",
        "/property:GenerateFullPaths=true",
        "/p:Configuration=Debug"
      ],
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "clean+build JobSearchAssistant.Ui",
      "dependsOrder": "sequence",
      "dependsOn": [
        "clean JobSearchAssistant.Ui",
        "build JobSearchAssistant.Ui"
      ],
      "problemMatcher": []
    },
    {
      "label": "clean Maui",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "clean",
        "${workspaceFolder}/src/Maui/Maui.csproj",
        "/property:GenerateFullPaths=true",
        "/p:Configuration=Debug"
      ],
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "build Maui",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Maui/Maui.csproj",
        "/property:GenerateFullPaths=true",
        "/p:Configuration=Debug"
      ],
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "clean+build Maui",
      "dependsOrder": "sequence",
      "dependsOn": [
        "clean Maui",
        "build Maui"
      ],
      "problemMatcher": []
    },
    {
      "label": "build Server",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Server/Server.csproj",
        "/property:GenerateFullPaths=true",
        "/p:Configuration=Debug"
      ],
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "build active project",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\build-active-project.ps1",
        "-ActiveFile",
        "${file}"
      ],
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false,
        "close": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "start server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\start-server.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    }
  ]
}
