{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "UI Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "clean+build JobSearchAssistant.Ui",
            "program": "${workspaceFolder}/src/JobSearchAssistant.Ui/bin/Debug/net10.0-windows/JobSearchAssistant.Ui.exe",
            "cwd": "${workspaceFolder}/src/JobSearchAssistant.Ui",
            "stopAtEntry": false
        },
        {
            "name": "Maui UI Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "clean+build Maui",
            "program": "${workspaceFolder}/src/Maui/bin/Debug/net10.0-windows10.0.19041.0/win-x64/Maui.exe",
            "cwd": "${workspaceFolder}/src/Maui",
            "stopAtEntry": false
        },
        {
            "name": "Server Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build Server",
            "program": "${workspaceFolder}/src/Server/bin/Debug/net10.0/Server.exe",
            "cwd": "${workspaceFolder}/src/Server",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Web.Ui Debug",
            "type": "pwa-node",
            "request": "launch",
            "cwd": "${workspaceFolder}/src/Web.Ui",
            "runtimeExecutable": "corepack",
            "runtimeArgs": [
                "pnpm",
                "dev"
            ],
            "console": "integratedTerminal",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Local:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            }
        }
    ],
    "compounds": [
        {
            "name": "debug Web",
            "configurations": [
                "Server Debug",
                "Web.Ui Debug"
            ]
        }
    ]
}